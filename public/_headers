# Response headers for files served from dist/ (Cloudflare static assets; wiki: Security).
#
# The Content-Security-Policy with script and style hashes is a <meta> tag on each page
# (astro.config.mjs). A <meta> tag cannot set frame-ancestors, so that one directive is sent
# here. The CI pipeline appends an X-Robots-Tag rule for previews and pre-launch production.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprinted by Astro (the file name changes with the content): cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable file names: cache for a month, not forever, so a replaced font still reaches visitors.
/fonts/*
  Cache-Control: public, max-age=2592000
