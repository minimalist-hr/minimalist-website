{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minimalist-website",
  "compatibility_date": "2026-09-17",

  // Worker script: handles POST /api/contact and hands every other request back to
  // the static assets (see src/worker/index.ts).
  "main": "./src/worker/index.ts",

  // Static assets built by Astro. Requests that match a file are served directly;
  // the rest reach the Worker, which returns env.ASSETS.fetch() so 404 pages still work.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },

  // Non-secret settings. Secrets (TURNSTILE_SECRET_KEY, RESEND_API_KEY) are set in the
  // Cloudflare dashboard or with `wrangler secret put`, and locally in .dev.vars.
  "vars": {
    "CONTACT_TO": "hello@minimalist.hr",
    "CONTACT_FROM": "form@minimalist.hr",
    // "resend" sends through Resend's API; "console" only logs (local development).
    "MAIL_PROVIDER": "resend"
  },

  // Custom domains: Cloudflare creates the DNS records. www redirects to the apex with a
  // Redirect Rule in the dashboard (it runs before the Worker and the static assets).
  "routes": [
    { "pattern": "minimalist.hr", "custom_domain": true },
    { "pattern": "www.minimalist.hr", "custom_domain": true }
  ],

  // Production answers only on minimalist.hr. The staging preview keeps its workers.dev URL:
  // preview_urls is set explicitly because it defaults to the value of workers_dev.
  "workers_dev": false,
  "preview_urls": true,

  "observability": {
    "enabled": true
  }
}
