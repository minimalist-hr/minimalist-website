---
/**
 * An image with a light-theme version renders both and the theme shows one. The light one is
 * always lazy: a hidden lazy image is never fetched, so the dark theme never downloads it.
 */
import { Image } from 'astro:assets';

import type { Locale } from '../i18n/config';
import { pick } from '../i18n/localized';
import { studioImage } from '../lib/images';

interface Props {
  /** Placeholder caption, e.g. "product shot / core banking console". */
  caption: string;
  /** Reserved ratio, e.g. "4/3" or "16/10". */
  ratio?: string;
  /** Key into the image registry. Without it the placeholder is shown. */
  image?: string | undefined;
  /** Needed with `image`, to pick the alt text. */
  locale?: Locale | undefined;
  /** Slot width across breakpoints, for the srcset. */
  sizes?: string;
  /** The one image above the fold on a page can load eagerly. */
  priority?: boolean;
  class?: string;
}

const {
  caption,
  ratio = '4/3',
  image,
  locale,
  sizes = '(min-width: 60rem) 33vw, 100vw',
  priority = false,
  class: className,
} = Astro.props;

const photo = locale ? studioImage(image) : undefined;

/** Crop box for the slot's ratio; Astro generates the smaller widths from it. */
const [w = 1, h = 1] = ratio.split('/').map((part) => Number(part.trim()));
const width = 1600;
const height = Math.round((width * h) / w);
---

<div
  class:list={['frame', className]}
  data-image={photo !== undefined}
  style={`--frame-ratio: ${ratio}`}
>
  {photo && locale ? (
    <>
      <Image
        src={photo.src}
        alt={pick(photo.alt, locale)}
        width={width}
        height={height}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        fit="cover"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        data-theme-image={photo.light ? 'dark' : undefined}
      />
      {photo.light && (
        <Image
          src={photo.light}
          alt={pick(photo.alt, locale)}
          width={width}
          height={height}
          widths={[480, 800, 1200, 1600]}
          sizes={sizes}
          fit="cover"
          loading="lazy"
          decoding="async"
          data-theme-image="light"
        />
      )}
    </>
  ) : (
    <span class="caption">{caption}</span>
  )}
</div>

<style>
  .frame {
    display: flex;
    /* full width of its slot: never sized by the caption length */
    width: 100%;
    align-items: flex-end;
    aspect-ratio: var(--frame-ratio);
    padding: 14px;
    background: repeating-linear-gradient(90deg, var(--stripe-a) 0 5px, var(--stripe-b) 5px 10px);
  }

  .frame[data-image='true'] {
    padding: 0;
    background: none;
  }

  /* :global, because <Image>'s root is a child component's element: a scoped class
     passed to it would be dropped. */
  .frame[data-image='true'] > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(:root:not([data-theme='light'])) .frame > :global(img[data-theme-image='light']),
  :global(:root[data-theme='light']) .frame > :global(img[data-theme-image='dark']) {
    display: none;
  }

  .caption {
    font-family: var(--font-mono);
    font-size: var(--text-label-sm);
    letter-spacing: var(--tracking-meta);
    color: var(--graphite);
  }
</style>
