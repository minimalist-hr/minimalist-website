---
/**
 * Primary action: ink fill with paper text, swapping to outline on hover (design).
 * Renders an <a> with `href`, otherwise a <button>.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { href, type = 'button', class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['button', className]} href={href} type={href ? undefined : type}>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding: 14px 22px;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-none);
    color: var(--paper);
    background: var(--ink);
    border: 0;
    box-shadow: inset 0 0 0 var(--hairline) var(--ink);
    transition:
      background var(--duration-lift) linear,
      color var(--duration-lift) linear;
  }

  @media (hover: hover) {
    .button:hover {
      background: var(--paper);
      color: var(--ink);
    }
  }
</style>
