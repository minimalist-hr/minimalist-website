---
/**
 * Label/value metadata. `row` is the case study header; `stack` is the article sidebar.
 * Items without a value are left out by the caller (client names need written permission).
 */
interface Props {
  items: { label: string; value: string | number }[];
  variant?: 'row' | 'stack';
  class?: string;
}

const { items, variant = 'row', class: className } = Astro.props;
---

<dl class:list={['meta', className]} data-variant={variant} data-draw>
  {items.map((item) => (
    <div class="item">
      <dt>{item.label}</dt>
      <dd>{item.value}</dd>
    </div>
  ))}
</dl>

<style>
  .meta {
    margin: 0;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
  }

  .meta[data-variant='row'] {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 24px;
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: 18px;
    border-top: var(--hairline) solid var(--rule);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label-tight);
  }

  .meta[data-variant='stack'] {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: var(--text-label-sm);
    letter-spacing: var(--tracking-label);
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  dt {
    color: var(--graphite);
  }

  dd {
    margin: 0;
    letter-spacing: var(--tracking-meta);
    color: var(--ink);
  }
</style>
