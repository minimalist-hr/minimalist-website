---
/**
 * Label/value metadata. `row` is the case study header; `stack` is the article sidebar.
 * Items without a value are left out by the caller (client names need written permission).
 * An item with `href` links out: new tab, with the hidden hint read after the value.
 */
export interface MetaItem {
  label: string;
  value: string | number;
  href?: string;
  /** "opens in a new tab", in the page's language. Needed with `href`. */
  newTabHint?: string;
}

interface Props {
  items: MetaItem[];
  variant?: 'row' | 'stack';
  class?: string;
}

const { items, variant = 'row', class: className } = Astro.props;
---

<dl class:list={['meta', className]} data-variant={variant} data-draw>
  {items.map((item) => (
    <div class="item">
      <dt>{item.label}</dt>
      <dd>
        {item.href ? (
          <a class="external" href={item.href} target="_blank" rel="noopener">
            <span class="link-line">{item.value}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
            {item.newTabHint && <span class="visually-hidden">{` (${item.newTabHint})`}</span>}
          </a>
        ) : (
          item.value
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .meta {
    margin: 0;
    font-weight: var(--weight-medium);
    text-transform: uppercase;
  }

  .meta[data-variant='row'] {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 24px;
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: 18px;
    border-top: var(--hairline) solid var(--rule);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label-tight);
  }

  .meta[data-variant='stack'] {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: var(--text-label-lg);
    letter-spacing: var(--tracking-label);
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  dt {
    color: var(--graphite);
  }

  dd {
    margin: 0;
    letter-spacing: var(--tracking-meta);
    color: var(--ink);
  }

  /* A domain reads better in lower case than the uppercase meta values around it. */
  .external {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    text-transform: none;
    color: var(--ink);
  }

  /* Tap target: 44px tall without changing the row's height. */
  .external::before {
    content: '';
    position: absolute;
    inset: -14px -8px;
  }

  .external .link-line {
    padding-bottom: 2px;
  }

  /* The text arrow turned to point out of the page; it lifts toward the corner on hover. */
  .arrow {
    display: inline-block;
    transform: rotate(-45deg);
    transition: transform var(--duration-lift) var(--ease);
  }

  @media (hover: hover) {
    .external:hover .arrow {
      transform: translate(2px, -2px) rotate(-45deg);
    }
  }
</style>
