---
/**
 * Client quote with attribution. Quotation marks belong to the quote text itself,
 * so Croatian keeps its „…” form (plan §7).
 */
interface Props {
  text: string;
  name: string;
  role: string;
}

const { text, name, role } = Astro.props;
---

<blockquote class="quote" data-draw>
  <p>{text}</p>
  <footer>
    {name}
    <span class="dot" aria-hidden="true"></span>
    {role}
  </footer>
</blockquote>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding-top: clamp(28px, 3.5vw, 48px);
    border-top: var(--hairline) solid var(--rule);
  }

  p {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
    line-height: 1.22;
  }

  footer {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .dot {
    display: inline-block;
    width: 3.4px;
    height: 3.4px;
    margin: 0 10px;
    vertical-align: middle;
    background: currentColor;
  }
</style>
