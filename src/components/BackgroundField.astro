<canvas class="field" data-background-field aria-hidden="true"></canvas>

<script>
  import { initBackgroundField } from '../scripts/background-field';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-background-field]');
  if (canvas) {
    initBackgroundField({
      canvas,
      hero: document.querySelector<HTMLElement>('[data-field-hero]'),
    });
  }
</script>

<style>
  /* z-index -1: under everything in the body, but over the page background, which is painted
     on the root. */
  .field {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  @media print {
    .field {
      display: none;
    }
  }
</style>
