---
/**
 * Vertical timeline of the six steps, in the same language as "How we work" on the home
 * page: one continuous rule with a square marker per step. Used on the Approach page,
 * where each step also carries a longer description and an image.
 * Mobile: the rule runs down the left. From md up it runs down the middle and the steps
 * alternate sides, each side starting half a step lower, so the columns interlock. Both
 * sides align to the rule. Each square sits on the rule, and a hairline runs from it to
 * underline the step's heading.
 * Motion: the rule draws down as the page scrolls (scroll-driven, where supported), and
 * each underline extends from its square as the step enters (src/scripts/reveal.ts).
 */
import type { Locale } from '../i18n/config';
import { pick } from '../i18n/localized';
import type { Step } from '../data/steps';
import ImageFrame from './ImageFrame.astro';

interface Props {
  steps: Step[];
  locale: Locale;
}

const { steps, locale } = Astro.props;
---

<ol class="timeline" role="list">
  {steps.map((step, index) => (
    <li class="step" style={`--row: ${index + 1}`} data-reveal-item>
      <div class="content">
        <div class="heading">
          <span class="marker" aria-hidden="true" />
          <span class="number">{step.number}</span>
          <h2>{pick(step.title, locale)}</h2>
        </div>
        <p class="detail">{pick(step.detail, locale)}</p>
        <div class="image-slot">
          <ImageFrame
            caption={step.caption}
            image={step.image}
            locale={locale}
            ratio="16/9"
            sizes="(min-width: 60rem) 42vw, 92vw"
          />
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 var(--hairline);
    view-timeline: --timeline block;
    /* The rule's end follows the point where steps enter (the reveal's -8% root margin). */
    view-timeline-inset: 0 8%;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    border-left: var(--hairline) solid var(--rule);
    transform-origin: top;
  }

  .step {
    /* Distance from the rule to the content. */
    --reach: clamp(22px, 3vw, 40px);

    padding-left: var(--reach);
  }

  .step:not(:last-child) {
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  /* The square sits on the rule, level with the heading's underline. */
  .marker {
    z-index: 1;
    position: absolute;
    bottom: -3px;
    left: calc(-1 * var(--reach) - 4px);
    width: 7px;
    height: 7px;
    background: var(--ink);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .heading {
    position: relative;
    display: flex;
    align-self: flex-start;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 10px;
  }

  /* The underline runs from the rule to the end of the heading. */
  .heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: calc(-1 * var(--reach));
    right: 0;
    border-bottom: var(--hairline) solid var(--rule);
    transform-origin: left;
  }

  /* Reveal: the underline extends from the square, just after the step starts to enter. */
  .step[data-reveal] .heading::after {
    transition: transform var(--duration-reveal) var(--ease) calc(var(--reveal-delay, 0ms) + 120ms);
  }

  .step[data-reveal='pending'] .heading::after {
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global([data-js]) .timeline::before {
        /* Longhands: the minifier would fold a timeline into the shorthand, which Chrome rejects. */
        animation-name: draw-down;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --timeline;
        animation-range: entry-crossing 0% entry-crossing 100%;
      }
    }
  }

  @keyframes draw-down {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  .number {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    color: var(--graphite);
  }

  h2 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-tight);
  }

  .detail {
    max-width: 62ch;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
  }

  /* The image never runs the full column on wide screens; it sits with the text. */
  .image-slot {
    width: 100%;
    max-width: 640px;
  }

  /*
   * Desktop (md and up): the rule down the middle, steps alternating sides. Each step spans
   * two grid rows and starts one row after the previous one, so a right-hand step begins
   * halfway down the left-hand step before it. Source order stays 1–6.
   */
  @media (min-width: 60rem) {
    .timeline {
      --gap: clamp(28px, 3.5vw, 56px);

      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: calc(2 * var(--gap));
      row-gap: clamp(20px, 2.5vw, 36px);
      padding: 0;
    }

    .timeline::before {
      left: 50%;
    }

    .step,
    .step:not(:last-child) {
      --reach: var(--gap);

      grid-row: var(--row) / span 2;
      padding: 0;
    }

    .step:nth-child(odd) {
      grid-column: 1;
    }

    .step:nth-child(even) {
      grid-column: 2;
    }

    /* Left-hand steps reach the middle rule from their right edge. */
    .step:nth-child(odd) .marker {
      left: auto;
      right: calc(-1 * var(--reach) - 4px);
    }

    .step:nth-child(odd) .heading::after {
      left: 0;
      right: calc(-1 * var(--reach));
      transform-origin: right;
    }

    .step:nth-child(even) .marker {
      left: calc(-1 * var(--reach) - 3px);
    }

    /* Left-hand steps align to the rule, so each heading ends beside its square. */
    .step:nth-child(odd) .content {
      align-items: flex-end;
      text-align: right;
    }

    .step:nth-child(odd) .heading {
      align-self: flex-end;
      justify-content: flex-end;
    }

    /* Every image takes the full column, so all six are the same size. */
    .image-slot {
      max-width: none;
    }
  }
</style>
