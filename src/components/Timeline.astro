---
/**
 * Vertical timeline of the six steps, in the same language as "How we work" on the home
 * page: one continuous rule with a square marker per step. Used on the Approach page,
 * where each step also carries a longer description and an image.
 */
import type { Locale } from '../i18n/config';
import { pick } from '../i18n/localized';
import type { Step } from '../data/steps';
import ImageFrame from './ImageFrame.astro';

interface Props {
  steps: Step[];
  locale: Locale;
}

const { steps, locale } = Astro.props;
---

<ol class="timeline" role="list">
  {steps.map((step) => (
    <li class="step">
      <span class="marker" aria-hidden="true" />
      <div class="content">
        <div class="heading">
          <span class="number">{step.number}</span>
          <h2>{pick(step.title, locale)}</h2>
        </div>
        <p class="detail">{pick(step.detail, locale)}</p>
        <div class="image-slot">
          <ImageFrame caption={step.caption} ratio="16/9" />
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    border-left: var(--hairline) solid var(--rule);
  }

  .step {
    position: relative;
    padding-left: clamp(22px, 3vw, 40px);
  }

  .step:not(:last-child) {
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  .marker {
    position: absolute;
    top: 6px;
    left: -4px;
    width: 7px;
    height: 7px;
    background: var(--ink);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .heading {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .number {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    color: var(--graphite);
  }

  h2 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-tight);
  }

  .detail {
    max-width: 62ch;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
  }

  /* The image never runs the full column on wide screens; it sits with the text. */
  .image-slot {
    width: 100%;
    max-width: 640px;
  }

  /*
   * Desktop (md and up): two columns, and the rule snakes through the steps.
   * Row 1 runs left to right (1, 2), drops down the right edge, row 2 runs right to left
   * (3 on the right, 4 on the left), drops down the left edge, row 3 runs left to right.
   * Source order stays 1–6, which is also the order along the line.
   */
  @media (min-width: 60rem) {
    .timeline {
      --pad: clamp(24px, 3vw, 40px);

      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row dense; /* lets step 4 fill the left cell of row 2 */
      border-left: 0;
    }

    .step,
    .step:not(:last-child) {
      padding: var(--pad) var(--pad) clamp(40px, 5vw, 72px);
      border-top: var(--hairline) solid var(--rule);
    }

    .step:nth-child(4n + 1),
    .step:nth-child(4n + 4) {
      grid-column: 1;
    }

    .step:nth-child(4n + 2),
    .step:nth-child(4n + 3) {
      grid-column: 2;
    }

    /* The drops between rows: right edge after step 2, left edge after step 4. */
    .step:nth-child(4n + 2):not(:last-child) {
      border-right: var(--hairline) solid var(--rule);
    }

    .step:nth-child(4n + 4):not(:last-child) {
      border-left: var(--hairline) solid var(--rule);
    }

    /* The square sits on the line, above the step's number. */
    .marker {
      top: -4px;
      left: var(--pad);
    }
  }
</style>
