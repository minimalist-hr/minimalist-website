---
/** Omit `alternates` (e.g. 404) to skip canonical and hreflang. */
import { defaultLocale, localeMeta, locales, type Locale } from '../i18n/config';
import { useTranslations, type Alternates } from '../i18n/utils';
import { siteConfig } from '../site.config';

const defaultImage = { src: '/og/default.png', width: '1200', height: '630' } as const;

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternates?: Alternates | undefined;
  image?: string | undefined;
}

const { title, description, locale, alternates, image } = Astro.props;
const t = useTranslations(locale);

const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path, site).href;
const canonical = alternates ? absolute(alternates[locale]) : undefined;
const otherLocales = locales.filter((l) => l !== locale);
const ogImage = absolute(image ?? defaultImage.src);
---

<title>{title}</title>
<meta name="description" content={description} />

{canonical && <link rel="canonical" href={canonical} />}
{alternates && (
  <>
    {locales.map((l) => (
      <link rel="alternate" hreflang={localeMeta[l].htmlLang} href={absolute(alternates[l])} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(alternates[defaultLocale])} />
  </>
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{otherLocales.map((l) => (
  <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />
))}
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={t('og.imageAlt')} />
{!image && (
  <>
    <meta property="og:image:width" content={defaultImage.width} />
    <meta property="og:image:height" content={defaultImage.height} />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
