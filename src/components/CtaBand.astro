---
/**
 * Closing call to action: one line, a primary button and a plain label link.
 */
import Button from './Button.astro';
import CtaLink from './CtaLink.astro';

interface Props {
  title: string;
  action: { href: string; label: string };
  secondary?: { href: string; label: string } | undefined;
}

const { title, action, secondary } = Astro.props;
---

<div class="band">
  <h2>{title}</h2>
  <div class="actions">
    <Button href={action.href}>{action.label}</Button>
    {secondary && (
      <CtaLink href={secondary.href} variant="plain">
        {secondary.label}
      </CtaLink>
    )}
  </div>
</div>

<style>
  .band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(24px, 3vw, 40px);
  }

  h2 {
    max-width: 22ch;
    font-size: var(--text-cta);
    letter-spacing: var(--tracking-headline);
    line-height: 1.05;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
  }
</style>
