---
/**
 * Must render early in <head>, after the theme-color meta it updates. The body lives in
 * lib/inline-scripts.ts so the CSP can list its exact hash.
 */
import { themeScript } from '../lib/inline-scripts';
import { defaultTheme, themeColors } from '../lib/theme';
---

<meta name="theme-color" content={themeColors[defaultTheme]} />
<script is:inline set:html={themeScript}></script>
