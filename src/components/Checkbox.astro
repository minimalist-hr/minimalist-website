---
/**
 * Labelled checkbox (plan §9.1): a real checkbox, so it works with the keyboard and screen
 * readers; only its look is custom. The box is the fields' 1px inset rule; checked = ink fill
 * with a paper tick, like a checked chip. The whole row is at least 44px tall.
 *
 * The label text is the slot, so it can hold a link. The error element follows the
 * TextField pattern (`{name}-error`), filled in by the form script.
 */
interface Props {
  name: string;
  value?: string;
  required?: boolean;
}

const { name, value = 'yes', required = false } = Astro.props;
const errorId = `${name}-error`;
---

<div class="field">
  {/* eslint-disable-next-line astro/jsx-a11y/label-has-associated-control -- the text is the slot, which the rule cannot see */}
  <label class="row">
    <input
      type="checkbox"
      name={name}
      value={value}
      required={required}
      aria-describedby={errorId}
    />
    <span class="box" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16">
        <path d="M5 12.5l4.5 4.5L19 7.5" />
      </svg>
    </span>
    <span class="text">
      <slot />
    </span>
  </label>
  <span class="error" id={errorId} hidden></span>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-height: var(--tap-target);
    padding: 10px 0;
    cursor: pointer;
  }

  /* The checkbox stays in the accessibility tree and takes focus; only the box is seen. */
  input {
    position: absolute;
    top: 10px;
    left: 0;
    width: 24px;
    height: 24px;
    margin: 0;
    opacity: 0;
  }

  .box {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--paper);
    /* Opaque, so the background field does not run through the box. */
    background: var(--paper);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule);
    transition:
      background var(--duration-state) linear,
      box-shadow var(--duration-state) linear;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
    visibility: hidden;
  }

  .text {
    padding-top: 2px;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-2);
  }

  .text :global(a) {
    color: var(--ink);
    border-bottom: var(--hairline) solid var(--rule);
    transition: border-color var(--duration-state) linear;
  }

  @media (hover: hover) {
    .row:hover .box {
      box-shadow: inset 0 0 0 var(--hairline) var(--ink);
    }

    .text :global(a:hover) {
      border-bottom-color: var(--ink);
    }
  }

  input:checked + .box {
    background: var(--ink);
    box-shadow: inset 0 0 0 var(--hairline) var(--ink);
  }

  input:checked + .box svg {
    visibility: visible;
  }

  input:focus-visible + .box {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  input[aria-invalid='true'] + .box {
    box-shadow: inset 0 0 0 var(--hairline) var(--ink);
  }

  /* Errors are ink, not a colour: the brand has no red (plan §3.1). */
  .error {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-normal);
    color: var(--ink);
  }

  .error::before {
    content: '— ';
  }
</style>
