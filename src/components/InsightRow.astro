---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { formatInsightDate } from '../lib/format';
import { insightPath, type InsightEntry } from '../lib/content';
import CtaLink from './CtaLink.astro';
import ImageFrame from './ImageFrame.astro';
import MetaRow from './MetaRow.astro';

interface Props {
  entry: InsightEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, category, excerpt, coverImage, coverCaption, date } = entry.data;
const t = useTranslations(locale);
---

<article class="row" data-draw data-reveal-item>
  <div class="image-slot">
    <ImageFrame
      caption={coverCaption}
      image={coverImage}
      locale={locale}
      ratio="4/3"
      sizes="(min-width: 60rem) 190px, 40vw"
    />
  </div>
  <div class="content">
    <MetaRow class="date" items={[formatInsightDate(date, locale), category]} />
    <h2>{title}</h2>
    <p class="excerpt">{excerpt}</p>
    {/* wrapper, not a class on <CtaLink>: scoped CSS would not reach its root element */}
    <div class="action">
      <CtaLink href={insightPath(entry, locale)}>{t('insights.readInsight')}</CtaLink>
    </div>
  </div>
</article>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(16px, 3vw, 44px);
    padding-block: clamp(24px, 3vw, 40px);
    /* inside the container already, so a plain border ends with the text */
    border-bottom: var(--hairline) solid var(--rule);
  }

  .image-slot {
    flex: 0 0 clamp(140px, 16vw, 190px);
  }

  .content {
    display: flex;
    flex: 1 1 420px;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .date {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label-tight);
  }

  h2 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-tight);
  }

  .excerpt {
    max-width: 78ch;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }

  .action {
    margin-top: clamp(4px, 0.8vw, 10px);
  }
</style>
