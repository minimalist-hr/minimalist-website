---
/**
 * Tool names as outlined tags. Names are product names, so they are never translated.
 */
interface Props {
  tools: string[];
}

const { tools } = Astro.props;
---

<ul class="tools" role="list">
  {tools.map((tool) => (
    <li class="tool">{tool}</li>
  ))}
</ul>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    font-size: var(--text-sm);
    line-height: var(--leading-none);
    /* Opaque, so the background field does not run through the tag. */
    background: var(--paper);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule);
    transition: box-shadow var(--duration-state) linear;
  }

  /* Highlight on hover, like the chips in the contact form. */
  @media (hover: hover) {
    .tool:hover {
      box-shadow: inset 0 0 0 var(--hairline) var(--ink);
    }
  }
</style>
