---
interface Props {
  href: string;
  variant?: 'rule' | 'plain';
  back?: boolean;
  class?: string;
}

const { href, variant = 'rule', back = false, class: className } = Astro.props;
---

<a class:list={['cta', className]} data-variant={variant} data-back={back || undefined} href={href}>
  {variant === 'rule' && back && (
    <span class="arrow" aria-hidden="true">
      ←
    </span>
  )}
  <span class:list={['text', variant === 'rule' && 'link-line']}>
    <slot />
  </span>
  {variant === 'rule' && !back && (
    <span class="arrow" aria-hidden="true">
      →
    </span>
  )}
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    /* keeps the link from stretching in column layouts without overriding
       vertical alignment when it sits in a row beside a button */
    width: fit-content;
    gap: 8px;
    padding-block: 6px;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-snug);
    text-transform: uppercase;
    color: var(--graphite);
    background: var(--paper);
    transition: color var(--duration-state) linear;
  }

  /* Beside a button: as tall as the button, with the paper box running 16px past the text
     on each side (the negative margin keeps the text where it was). */
  .cta[data-variant='plain'] {
    min-height: var(--tap-target);
    padding-inline: 16px;
    margin-inline: -16px;
  }

  .cta[data-variant='rule'] .text {
    padding-bottom: 3px;
  }

  /* The arrow is centred on the label, not on the label's box: the rule variant adds
     3px under the text, so the arrow gets the same 3px under it to cancel the offset. */
  .arrow {
    line-height: var(--leading-none);
    transition: transform var(--duration-reveal) var(--ease);
  }

  .cta[data-variant='rule'] .arrow {
    margin-bottom: 3px;
  }

  @media (hover: hover) {
    .cta:hover {
      color: var(--ink);
    }

    .cta:hover .arrow {
      transform: translateX(5px);
    }

    .cta[data-back]:hover .arrow {
      transform: translateX(-5px);
    }
  }
</style>
