---
/**
 * Labelled text input or textarea (plan §5.3, §9.1): 16px text (no iOS zoom), 48px minimum
 * height, a 1px inset rule that turns ink on focus. The label wraps the control, so they
 * are always associated.
 */
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email';
  required?: boolean;
  autocomplete?: string;
  placeholder?: string;
  /** Short help text under the field, linked with aria-describedby. */
  hint?: string;
  multiline?: boolean;
  rows?: number;
  maxlength?: number;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  placeholder,
  hint,
  multiline = false,
  rows = 5,
  maxlength,
} = Astro.props;

const hintId = hint ? `${name}-hint` : undefined;
/** Filled in by the form script when the value is invalid (see ContactForm). */
const errorId = `${name}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
---

<label class="field">
  <span class="label">{label}</span>
  {multiline ? (
    <textarea
      name={name}
      rows={rows}
      required={required}
      placeholder={placeholder}
      maxlength={maxlength}
      aria-describedby={describedBy}
    ></textarea>
  ) : (
    <input
      type={type}
      name={name}
      required={required}
      autocomplete={autocomplete}
      placeholder={placeholder}
      maxlength={maxlength}
      aria-describedby={describedBy}
    />
  )}
  {hint && (
    <span class="hint" id={hintId}>
      {hint}
    </span>
  )}
  <span class="error" id={errorId} hidden></span>
</label>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .label {
    font-size: var(--text-label-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  input,
  textarea {
    min-height: var(--row-min-height);
    padding: 12px 14px;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    /* Opaque, so the background field does not run through the field. */
    background: var(--paper);
    border: 0;
    border-radius: 0;
    box-shadow: inset 0 0 0 var(--hairline) var(--rule);
    transition: box-shadow var(--duration-state) linear;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 var(--hairline) var(--ink);
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    box-shadow: inset 0 0 0 var(--hairline) var(--ink);
  }

  /* Errors are ink, not a colour: the brand has no red (plan §3.1). */
  .error {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-normal);
    color: var(--ink);
  }

  .error::before {
    content: '— ';
  }

  .hint {
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--graphite);
  }
</style>
