---
/**
 * Section heading with an optional link to the full page, e.g. "Selected work" + "Work".
 */
import CtaLink from './CtaLink.astro';

interface Props {
  title: string;
  link?: { href: string; label: string } | undefined;
}

const { title, link } = Astro.props;
---

<div class="header">
  <h2>{title}</h2>
  {link && <CtaLink href={link.href}>{link.label}</CtaLink>}
</div>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  h2 {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-subtitle);
  }
</style>
