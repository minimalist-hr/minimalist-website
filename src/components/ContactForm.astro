---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

import type { Locale } from '../i18n/config';
import { localizedPath, useTranslations } from '../i18n/utils';
import {
  budgetAmounts,
  budgetValues,
  contactEndpoint,
  fieldLimits,
  honeypotField,
  timelineValues,
  type Budget,
} from '../lib/inquiry';
import { siteConfig } from '../site.config';
import Button from './Button.astro';
import Checkbox from './Checkbox.astro';
import ChipGroup from './ChipGroup.astro';
import TextField from './TextField.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { email } = siteConfig;
/** Copy with an {email} placeholder; the address is rendered as a mailto link. */
const [noscriptBefore, noscriptAfter = ''] = t('form.noscript').split('{email}');
/** Consent copy with a {link} placeholder for the privacy policy. */
const [consentBefore, consentAfter = ''] = t('form.consent').split('{link}');

const timelineOptions = timelineValues.map((value) => ({
  value,
  label: t(`form.timeline.${value}`),
}));

/** Amounts are not translated; only the "not sure" option is. */
const budgetLabels: Record<Budget, string> = {
  ...budgetAmounts,
  unsure: t('form.budget.unsure'),
};
const budgetOptions = budgetValues.map((value) => ({ value, label: budgetLabels[value] }));

/** Strings the script needs, passed as data so the script itself holds no copy. */
const messages = {
  sending: t('form.sending'),
  invalid: t('form.errorInvalid'),
  verification: t('form.errorVerification'),
  send: t('form.errorSend'),
  email,
  fields: {
    name: t('form.errorName'),
    email: t('form.errorEmail'),
    brief: t('form.errorBrief'),
    consent: t('form.errorConsent'),
  },
  tooLong: t('form.errorTooLong'),
};
---

<form
  class="form"
  action={contactEndpoint}
  method="post"
  data-contact-form
  data-messages={JSON.stringify(messages)}
>
  <noscript>
    <p class="notice">
      {noscriptBefore}
      <a href={`mailto:${email}`}>{email}</a>
      {noscriptAfter}
    </p>
  </noscript>

  <div class="body" data-form-body>
    <input type="hidden" name="locale" value={locale} />

    <div class="pairs">
      <TextField
        name="name"
        label={t('form.name')}
        required
        autocomplete="name"
        placeholder={t('form.placeholder.name')}
        maxlength={fieldLimits.name}
      />
      <TextField
        name="email"
        label={t('form.email')}
        type="email"
        required
        autocomplete="email"
        placeholder={t('form.placeholder.email')}
        maxlength={fieldLimits.email}
      />
      <TextField
        name="company"
        label={t('form.company')}
        autocomplete="organization"
        placeholder={t('form.placeholder.company')}
        maxlength={fieldLimits.company}
      />
      <TextField
        name="role"
        label={t('form.role')}
        autocomplete="organization-title"
        placeholder={t('form.placeholder.role')}
        maxlength={fieldLimits.role}
      />
    </div>

    <ChipGroup name="timeline" legend={t('form.timeline')} options={timelineOptions} />
    <ChipGroup name="budget" legend={t('form.budget')} unit="EUR" options={budgetOptions} />

    <TextField
      name="brief"
      label={t('form.brief')}
      hint={t('form.briefHint')}
      required
      multiline
      maxlength={fieldLimits.brief}
    />

    <Checkbox name="consent" required>
      {consentBefore}
      <a href={localizedPath('legal', locale)}>{t('form.consentLink')}</a>
      {consentAfter}
    </Checkbox>

    <!-- Honeypot: invisible to people, filled in by bots; the Worker drops those. -->
    <div class="honeypot" aria-hidden="true">
      <label>
        {t('form.honeypot')}
        <input type="text" name={honeypotField} tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <!-- Turnstile renders here only when it needs an interaction. -->
    <div data-turnstile data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-language={locale}></div>

    <p class="notice" data-form-error role="alert" hidden></p>

    <div class="actions">
      <Button type="submit">{t('form.submit')}</Button>
      <p class="note">{t('form.replyTime')}</p>
    </div>
  </div>

  <div class="success" data-form-success role="status" tabindex="-1" hidden>
    <p class="success-title">{t('form.successTitle')}</p>
    <p class="success-text">{t('form.successText')}</p>
  </div>
</form>

<script>
  import { enhanceContactForm } from '../scripts/contact-form';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(enhanceContactForm);
</script>

<style>
  .form,
  .body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* `display` would otherwise override the hidden attribute set by the script. */
  .body[hidden] {
    display: none;
  }

  .pairs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .notice {
    max-width: 52ch;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-body);
    color: var(--ink);
  }

  /* :global — the error message link is created by the script, outside Astro's scoping. */
  .notice :global(a) {
    border-bottom: var(--hairline) solid var(--rule);
    transition: border-color var(--duration-state) linear;
  }

  @media (hover: hover) {
    .notice :global(a:hover) {
      border-bottom-color: var(--ink);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
  }

  .note {
    max-width: 32ch;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--graphite);
  }

  .success {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(24px, 3vw, 36px);
    background: var(--paper);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule);
  }

  .success[hidden] {
    display: none;
  }

  .success:focus {
    outline: none;
  }

  .success-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-title);
  }

  .success-text {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
  }

  @media (min-width: 40rem) {
    .pairs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(20px, 2.5vw, 28px);
    }
  }

  @media (min-width: 60rem) {
    .form,
    .body {
      gap: clamp(24px, 3vw, 34px);
    }
  }
</style>
