---
/**
 * Page section: centred container, fluid vertical rhythm and the hairline that separates
 * sections in the design. Sizes come from the designs (mobile 48px → desktop 104px).
 */
interface Props {
  /** Hairline under the section. The last section before the footer sets this to false. */
  bordered?: boolean;
  /**
   * `lead`  — larger padding, used by the closing block (design).
   * `header` — page header: normal space above, tighter below (design).
   */
  size?: 'default' | 'lead' | 'header';
  /** Drops the top padding, for a section that follows a page header. */
  flushTop?: boolean;
  /**
   * Pulls the rule up closer to the content. The home page stacks six of these, and the
   * full gap on both sides of every rule leaves the sections floating apart.
   */
  tight?: boolean;
  class?: string;
  id?: string;
}

const {
  bordered = true,
  size = 'default',
  flushTop = false,
  tight = false,
  class: className,
  id,
} = Astro.props;
---

<section
  class:list={['section', className]}
  data-size={size}
  data-flush-top={flushTop}
  data-tight={tight}
  data-bordered={bordered}
  id={id}
>
  <div class:list={['container', bordered && 'rule-bottom']}>
    <slot />
  </div>
</section>

<style>
  /* Vertical rhythm lives on the section; the rule sits on the container so it runs to the
     width of the content, as in the design. Only the footer's rule spans the whole window. */
  .section {
    --section-end: clamp(48px, 7vw, 104px);
    padding-top: clamp(48px, 7vw, 104px);
  }

  .section[data-size='lead'] {
    --section-end: clamp(56px, 8vw, 120px);
    padding-top: clamp(56px, 8vw, 120px);
  }

  /* Page header: the design keeps a tighter gap between the lede and its rule. */
  .section[data-size='header'] {
    --section-end: clamp(32px, 4vw, 56px);
  }

  .section[data-tight='true'] {
    --section-end: clamp(30px, 4vw, 60px);
  }

  .section[data-flush-top='true'] {
    padding-top: 0;
  }

  /* The space above the rule belongs to the block, so the opaque container covers it. */
  .container {
    padding-bottom: var(--section-end);
  }

  /* With no rule, the space under the content is a gap, and the background field shows in it
     (wiki: Background field). */
  .section[data-bordered='false'] {
    padding-bottom: var(--section-end);
  }

  .section[data-bordered='false'] .container {
    padding-bottom: 0;
  }
</style>
