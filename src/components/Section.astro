---
interface Props {
  /** Hairline under the section. The last section before the footer sets this to false. */
  bordered?: boolean;
  /**
   * `lead`  — larger padding, used by the closing block.
   * `header` — page header: normal space above, tighter below.
   */
  size?: 'default' | 'lead' | 'header';
  /** Drops the top padding, for a section that follows a page header. */
  flushTop?: boolean;
  /**
   * Pulls the rule up closer to the content. The home page stacks six of these, and the
   * full gap on both sides of every rule leaves the sections floating apart.
   */
  tight?: boolean;
  class?: string;
  id?: string;
}

const {
  bordered = true,
  size = 'default',
  flushTop = false,
  tight = false,
  class: className,
  id,
} = Astro.props;
---

<section
  class:list={['section', className]}
  data-size={size}
  data-flush-top={flushTop}
  data-tight={tight}
  id={id}
>
  <div class:list={['container', bordered && 'rule-bottom']}>
    <slot />
  </div>
</section>

<style>
  /* Vertical rhythm lives on the section; the rule sits on the container so it runs to the
     width of the content. Only the footer's rule spans the whole window. */
  .section {
    padding-top: clamp(48px, 7vw, 104px);
  }

  .section[data-size='lead'] {
    padding-top: clamp(56px, 8vw, 120px);
  }

  .section[data-flush-top='true'] {
    padding-top: 0;
  }

  .container {
    padding-bottom: clamp(48px, 7vw, 104px);
  }

  .section[data-size='lead'] .container {
    padding-bottom: clamp(56px, 8vw, 120px);
  }

  .section[data-size='header'] .container {
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .section[data-tight='true'] .container {
    padding-bottom: clamp(30px, 4vw, 60px);
  }
</style>
