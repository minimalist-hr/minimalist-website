---
/**
 * Case study card used in "Selected work". Published entries link to the case study;
 * entries still being written show "[ case study in progress ]" (wiki: Data model). The line under
 * the title is the result metric, or the summary until there is one.
 */
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { workPath, type WorkEntry } from '../lib/content';
import CtaLink from './CtaLink.astro';
import ImageFrame from './ImageFrame.astro';
import MetaRow from './MetaRow.astro';

interface Props {
  entry: WorkEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, sector, year, cardMetric, summary, coverImage, coverCaption, status } = entry.data;
const t = useTranslations(locale);
---

<article class="card" data-reveal-item>
  <ImageFrame caption={coverCaption} image={coverImage} locale={locale} ratio="4/3" />
  <div class="body">
    <MetaRow items={[sector, year]} />
    <h3>{title}</h3>
    <p class="metric">{cardMetric ?? summary}</p>
    {/* wrapper, not a class on <CtaLink>: scoped CSS would not reach its root element */}
    <div class="action">
      {status === 'published' ? (
        <CtaLink href={workPath(entry, locale)}>{t('work.readCaseStudy')}</CtaLink>
      ) : (
        <p class="in-progress">{t('work.inProgress')}</p>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  h3 {
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-title);
    line-height: var(--leading-tight);
  }

  .metric {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-2);
  }

  .action {
    margin-top: clamp(10px, 1.4vw, 18px);
  }

  .in-progress {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }
</style>
