---
interface Props {
  label?: string | undefined;
  title: string;
  lede?: string | undefined;
  compact?: boolean;
}

const { label, title, lede, compact = false } = Astro.props;
---

<div class="page-header" data-compact={compact}>
  {label && <p class="label">{label}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
</div>

<style>
  .label {
    margin-bottom: 20px;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  h1 {
    max-width: 20ch;
    font-size: var(--text-6xl);
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
  }

  [data-compact='true'] h1 {
    font-size: var(--text-title-compact);
    letter-spacing: var(--tracking-headline);
    line-height: 1.05;
  }

  /* pretty, not balance: balance evens the lines out and so keeps a short lede far
     inside its measure, which is the opposite of what the wide column is for. */
  .lede {
    max-width: 64ch;
    text-wrap: pretty;
    margin-top: clamp(20px, 2.5vw, 32px);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }

  [data-compact='true'] .lede {
    max-width: 76ch;
    margin-top: 20px;
    line-height: var(--leading-relaxed);
  }
</style>
