---
/**
 * Insight card: date and category, title, placeholder image, link to the article.
 */
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { insightPath, type InsightEntry } from '../lib/content';
import { formatInsightDate } from '../lib/format';
import CtaLink from './CtaLink.astro';
import ImageFrame from './ImageFrame.astro';
import MetaRow from './MetaRow.astro';

interface Props {
  entry: InsightEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, category, excerpt, coverCaption, date } = entry.data;
const t = useTranslations(locale);

const dateLabel = formatInsightDate(date, locale);
---

<article class="card" data-draw data-reveal-item>
  <MetaRow items={[dateLabel, category]} />
  <h3>{title}</h3>
  <p class="excerpt">{excerpt}</p>
  <div class="image-slot">
    <ImageFrame caption={coverCaption} ratio="16/10" />
  </div>
  {/* wrapper, not a class on <CtaLink>: scoped CSS would not reach its root element */}
  <div class="action">
    <CtaLink href={insightPath(entry, locale)}>{t('insights.readInsight')}</CtaLink>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding-top: 18px;
    border-top: var(--hairline) solid var(--rule);
  }

  h3 {
    font-size: var(--text-base);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  .excerpt {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-2);
  }

  /* margin-top:auto keeps the image (and the link under it) level across cards
     whatever the length of the title and excerpt. */
  .image-slot {
    width: 100%;
    margin-top: auto;
    padding-top: 2px;
  }

  .action {
    margin-top: clamp(6px, 1vw, 12px);
  }
</style>
