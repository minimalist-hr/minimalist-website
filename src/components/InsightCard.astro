---
/**
 * Insight card: date and category, title, placeholder image, link to the article.
 */
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { insightPath, type InsightEntry } from '../lib/content';
import { formatInsightDate } from '../lib/format';
import CtaLink from './CtaLink.astro';
import ImageFrame from './ImageFrame.astro';
import MetaRow from './MetaRow.astro';

interface Props {
  entry: InsightEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, category, coverCaption, date } = entry.data;
const t = useTranslations(locale);

const dateLabel = formatInsightDate(date, locale);
---

<article class="card" data-draw data-reveal-item>
  <MetaRow items={[dateLabel, category]} />
  <h3>{title}</h3>
  <div class="image-slot">
    <ImageFrame caption={coverCaption} ratio="16/10" />
  </div>
  <CtaLink href={insightPath(entry, locale)}>{t('insights.readInsight')}</CtaLink>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding-top: 18px;
    border-top: var(--hairline) solid var(--rule);
  }

  h3 {
    /* min-height keeps images aligned across cards with one- or two-line titles */
    min-height: 2.5em;
    font-size: var(--text-base);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  /* margin-top:auto keeps the image (and the link under it) level across cards
     whether the title runs to one line or two. */
  .image-slot {
    width: 100%;
    margin-top: auto;
    padding-top: 2px;
  }
</style>
