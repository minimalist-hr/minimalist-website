---
/**
 * A small uppercase label beside a block of content, wrapping to one column on narrow
 * screens. Used for the pricing note, the FAQ and the Skills rows.
 */
interface Props {
  label?: string | undefined;
  /** Hairline above the row. */
  bordered?: boolean;
  /** Vertical padding for stacked rows, e.g. the Skills areas (design). */
  padded?: boolean;
  /** Width of the label column; the design uses 240px, and 200px on Legal. */
  sideWidth?: string;
  class?: string;
}

const {
  label,
  bordered = false,
  padded = false,
  sideWidth = '240px',
  class: className,
} = Astro.props;
---

<div
  class:list={['row', className]}
  data-bordered={bordered}
  data-padded={padded}
  data-draw
  style={`--side-width: ${sideWidth}`}
>
  <div class="side">
    {label && <p class="label">{label}</p>}
    <slot name="side" />
  </div>
  <div class="main">
    <slot />
  </div>
</div>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 44px);
  }

  .row[data-bordered='true'] {
    border-top: var(--hairline) solid var(--rule);
  }

  .row[data-padded='true'] {
    padding-block: clamp(28px, 3.5vw, 48px);
  }

  .side {
    flex: 0 0 var(--side-width);
  }

  .label {
    padding-top: 6px;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .main {
    flex: 1 1 420px;
  }
</style>
