---
/**
 * Home hero: studio label, rotating headline, lede, actions, scroll cue.
 *
 * The headline cycles four phrases on an 18s loop, 4.5s each (wiki: Motion). Only the first
 * phrase is exposed to screen readers, so the heading does not change underneath them;
 * with reduced motion the first phrase is simply shown.
 *
 * Each phrase arrives as its lines rather than as one string. The phrases sit stacked in
 * one grid cell, so the heading is as tall as the longest of them; left to wrap on their
 * own, a phone shows some at three lines and some at two, and the short ones leave a hole
 * under the heading. Below md the lines are set by hand so every phrase is three deep.
 * From md up they run back together and wrap on their own, which lands on two lines for
 * every phrase but one: the Croatian "Manje šuma. Bolji softver." fits on a single line
 * and leaves the same hole. `breakBefore` forces that one's second line.
 */
import Button from './Button.astro';
import CtaLink from './CtaLink.astro';

/** A headline phrase, split into the lines the mobile design sets by hand. */
export interface Phrase {
  lines: string[];
  /**
   * Index of the line that starts a new line from md up. Left unset, the phrase wraps on
   * its own, which is what the other phrases want.
   */
  breakBefore?: number;
}

interface Props {
  label: string;
  phrases: Phrase[];
  lede: string;
  action: { href: string; label: string };
  secondary: { href: string; label: string };
  scroll: string;
}

const { label, phrases, lede, action, secondary, scroll } = Astro.props;
const [first, ...rest] = phrases;
---

<section class="hero" data-field-hero>
  <div class="hero-inner container">
    <p class="studio-label">{label}</p>

    <h1>
      <span class="phrase">
        {first?.lines.map((line, index) => (
          <>
            {index > 0 && ' '}
            <span class="line" data-break={index === first.breakBefore ? '' : undefined}>
              {line}
            </span>
          </>
        ))}
      </span>
      {rest.map((phrase, index) => (
        <span class="phrase" aria-hidden="true" style={`--delay: ${(index + 1) * 4.5}s`}>
          {phrase.lines.map((line, lineIndex) => (
            <>
              {lineIndex > 0 && ' '}
              <span class="line" data-break={lineIndex === phrase.breakBefore ? '' : undefined}>
                {line}
              </span>
            </>
          ))}
        </span>
      ))}
    </h1>

    <p class="lede">{lede}</p>

    <div class="actions">
      <Button href={action.href}>{action.label}</Button>
      <CtaLink href={secondary.href} variant="plain">
        {secondary.label}
      </CtaLink>
    </div>

    <p class="scroll" aria-hidden="true">
      <span class="scroll-text">{scroll}</span>
      <span class="scroll-arrow">↓</span>
    </p>
  </div>
</section>

<script>
  // Fits the headline's blurred patch to its widest phrase (see the styles). The phrases share
  // one grid cell, so the widest one sets the patch for all of them.
  const heading = document.querySelector<HTMLElement>('.hero h1');
  if (heading) {
    const fit = (): void => {
      const left = heading.getBoundingClientRect().left;
      let right = left;
      heading.querySelectorAll('.phrase').forEach((phrase) => {
        const range = document.createRange();
        range.selectNodeContents(phrase);
        for (const rect of range.getClientRects()) right = Math.max(right, rect.right);
      });
      heading.style.setProperty('--phrase-width', `${Math.ceil(right - left)}px`);
    };
    new ResizeObserver(fit).observe(heading);
    void document.fonts.ready.then(fit);
  }
</script>

<style>
  /*
   * The hero's closing rule runs the full width of the window, not the width of the text like
   * the sections below it: it is the boundary between the hero and the rest of the page, drawn
   * under the scroll cue. The background field (BackgroundField.astro) reads this section's
   * [data-field-hero] to know how far its full-strength stretch reaches.
   */
  .hero {
    border-bottom: var(--hairline) solid var(--rule);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height) - env(safe-area-inset-top));
    padding-block: 44px 56px;
  }

  /*
   * The text sits on a blurred patch of the background field (wiki: Background field), a little
   * larger than the text box. A pseudo-element, so the layout does not move; z-index -1 puts it
   * under the text and over the field. The vertical reach stays under half the smallest gap
   * between the elements, so two patches never overlap and blur twice. The elements shrink to
   * their text, so each patch ends with it.
   */
  .studio-label,
  h1,
  .lede,
  .scroll {
    position: relative;
    align-self: flex-start;
  }

  .studio-label::before,
  h1::before,
  .lede::before,
  .scroll::before {
    --blur-reach: clamp(16px, 2vw, 28px);
    content: '';
    position: absolute;
    inset: -12px calc(-1 * var(--blur-reach));
    z-index: -1;
    pointer-events: none;
    backdrop-filter: blur(8px);
    /* Lets a trace of the sharp lines through, so the patch reads as frosted, not solid. */
    opacity: 0.7;
  }

  /* The headline's box is as wide as its max-width; the script below measures the widest
     phrase, so the patch ends with the text instead. */
  h1::before {
    right: calc(100% - var(--phrase-width, 100%) - var(--blur-reach));
  }

  .studio-label {
    margin-bottom: 40px;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  h1 {
    display: grid;
    max-width: 16ch;
    font-size: var(--text-display);
    letter-spacing: -0.05em;
    line-height: 0.96;
    text-wrap: initial;
  }

  /* Hand-set lines below md; one wrapping line from md up (see the note at the top). */
  .line {
    display: block;
  }

  .phrase {
    grid-area: 1 / 1;
    opacity: 0;
    animation: phrase 18s var(--ease) infinite;
    animation-delay: var(--delay, 0s);
  }

  @keyframes phrase {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    2%,
    22% {
      opacity: 1;
      transform: none;
    }
    25%,
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Show only the first phrase, as in both designs. */
    .phrase {
      opacity: 0;
    }

    .phrase:first-child {
      opacity: 1;
    }
  }

  .lede {
    max-width: 52ch;
    margin-top: 40px;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    margin-top: 56px;
    /* The least space above the scroll cue, kept here so the cue's box ends with its text. */
    margin-bottom: 36px;
  }

  .scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;
    gap: 8px;
    margin-top: auto;
    font-size: var(--text-label-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
    user-select: none;
  }

  /* The cue's text and arrow move, not the cue, so its blurred patch stays still. */
  .scroll > * {
    animation: cue 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .scroll-arrow {
    font-size: var(--text-xs);
    line-height: var(--leading-none);
  }

  /* Moves only; no fade, so the text never drops below contrast (WCAG 1.4.3). */
  @keyframes cue {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  /* ---- Desktop design (md and up): the design's tighter fluid rhythm ---- */
  @media (min-width: 60rem) {
    .hero-inner {
      padding-block: clamp(56px, 10vw, 150px) clamp(28px, 4vw, 44px);
    }

    .studio-label {
      margin-bottom: clamp(24px, 4vw, 44px);
    }

    .lede {
      margin-top: clamp(24px, 3vw, 40px);
    }

    .actions {
      margin-top: clamp(28px, 4vw, 48px);
      margin-bottom: 0;
    }

    h1 {
      max-width: 18ch;
      letter-spacing: var(--tracking-display);
      line-height: var(--leading-display);
      text-wrap: balance;
    }

    .line {
      display: inline;
    }

    /* A newline rather than display:block: the lines after it must still run together
       on the second line, which a block would break apart. */
    .line[data-break]::before {
      content: '\A';
      white-space: pre;
    }

    .lede {
      max-width: 58ch;
    }

    /* arrow first, on one line, aligned left */
    .scroll {
      flex-direction: row-reverse;
      align-self: flex-start;
      gap: 12px;
    }
  }
</style>
