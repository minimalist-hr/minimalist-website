---
/**
 * Home hero: availability signal, studio label, rotating headline, lede, actions, scroll cue.
 *
 * The headline cycles four phrases on an 18s loop, 4.5s each (plan §3.5). Only the first
 * phrase is exposed to screen readers, so the heading does not change underneath them;
 * with reduced motion the first phrase is simply shown.
 */
import Button from './Button.astro';
import CtaLink from './CtaLink.astro';

interface Props {
  available: string;
  label: string;
  phrases: string[];
  lede: string;
  action: { href: string; label: string };
  secondary: { href: string; label: string };
  scroll: string;
}

const { available, label, phrases, lede, action, secondary, scroll } = Astro.props;
const [first, ...rest] = phrases;
---

<section class="hero">
  <div class="hero-inner container rule-bottom">
    <p class="available">
      <span class="signal" aria-hidden="true">
        <span class="signal-dot"></span>
        <span class="signal-ping"></span>
      </span>
      {available}
    </p>

    <p class="studio-label">{label}</p>

    <h1>
      <span class="phrase">{first}</span>
      {rest.map((phrase, index) => (
        <span class="phrase" aria-hidden="true" style={`--delay: ${(index + 1) * 4.5}s`}>
          {phrase}
        </span>
      ))}
    </h1>

    <p class="lede">{lede}</p>

    <div class="actions">
      <Button href={action.href}>{action.label}</Button>
      <CtaLink href={secondary.href} variant="plain">
        {secondary.label}
      </CtaLink>
    </div>

    <p class="scroll" aria-hidden="true">
      <span class="scroll-text">{scroll}</span>
      <span class="scroll-arrow">↓</span>
    </p>
  </div>
</section>

<style>
  /* The rule (.rule-bottom) runs to the width of the text, like the sections below. */
  .hero-inner {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-height) - env(safe-area-inset-top));
    padding-block: 44px 56px;
  }

  .available {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 48px;
    font-size: var(--text-lead);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }

  .signal {
    position: relative;
    flex: none;
    width: 9px;
    height: 9px;
  }

  .signal-dot {
    position: absolute;
    inset: 0;
    background: var(--ink);
    animation: signal 1.8s steps(1, end) infinite;
  }

  .signal-ping {
    position: absolute;
    inset: -6px;
    box-shadow: 0 0 0 var(--hairline) var(--ink);
    animation: ping 1.8s var(--ease) infinite;
  }

  @keyframes signal {
    0%,
    70% {
      opacity: 1;
    }
    71%,
    100% {
      opacity: 0.25;
    }
  }

  @keyframes ping {
    0% {
      opacity: 0.7;
      transform: scale(0.45);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  .studio-label {
    margin-bottom: 40px;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  h1 {
    display: grid;
    max-width: 16ch;
    font-size: var(--text-display);
    letter-spacing: -0.05em;
    line-height: 0.96;
    text-wrap: initial;
  }

  .phrase {
    grid-area: 1 / 1;
    opacity: 0;
    animation: phrase 18s var(--ease) infinite;
    animation-delay: var(--delay, 0s);
  }

  @keyframes phrase {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    2%,
    22% {
      opacity: 1;
      transform: none;
    }
    25%,
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Show only the first phrase, as in both designs. */
    .phrase {
      opacity: 0;
    }

    .phrase:first-child {
      opacity: 1;
    }
  }

  .lede {
    max-width: 42ch;
    margin-top: 40px;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    margin-top: 56px;
  }

  .scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 36px;
    font-size: var(--text-label-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
    user-select: none;
    animation: cue 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .scroll-arrow {
    font-size: var(--text-xs);
    line-height: var(--leading-none);
  }

  /* Moves only; no fade, so the text never drops below contrast (WCAG 1.4.3). */
  @keyframes cue {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  /* ---- Desktop design (md and up): the design's tighter fluid rhythm ---- */
  @media (min-width: 60rem) {
    .hero-inner {
      padding-block: clamp(56px, 10vw, 150px) clamp(28px, 4vw, 44px);
    }

    .available {
      margin-bottom: clamp(20px, 3vw, 32px);
    }

    .studio-label {
      margin-bottom: clamp(24px, 4vw, 44px);
    }

    .lede {
      margin-top: clamp(24px, 3vw, 40px);
    }

    .actions {
      margin-top: clamp(28px, 4vw, 48px);
    }

    h1 {
      max-width: 18ch;
      letter-spacing: var(--tracking-display);
      line-height: var(--leading-display);
      text-wrap: balance;
    }

    .lede {
      max-width: 46ch;
    }

    /* arrow first, on one line, aligned left */
    .scroll {
      flex-direction: row-reverse;
      align-self: flex-start;
      gap: 12px;
      padding-top: 0;
    }
  }
</style>
