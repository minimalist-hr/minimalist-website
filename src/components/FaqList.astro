---
/**
 * Questions and answers, two columns from md up. Answers are always visible, as in the
 * design, so there is no disclosure widget to operate (plan §11.2).
 */
import type { Locale } from '../i18n/config';
import { pick } from '../i18n/localized';
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
  locale: Locale;
}

const { items, locale } = Astro.props;
---

<dl class="faq">
  {items.map((item, index) => (
    <div class="item" data-bordered={index > 1} data-draw data-reveal-item>
      <dt>{pick(item.question, locale)}</dt>
      <dd>{pick(item.answer, locale)}</dd>
    </div>
  ))}
</dl>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(22px, 2.6vw, 36px);
    margin: 0;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* The design rules every row after the first. */
  .item[data-bordered='true'] {
    padding-top: clamp(18px, 2.2vw, 26px);
    border-top: var(--hairline) solid var(--rule);
  }

  dt {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
  }

  dd {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 44%), 1fr));
    }
  }
</style>
