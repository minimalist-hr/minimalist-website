---
import type { Locale } from '../i18n/config';
import { pick } from '../i18n/localized';
import type { SkillGroup } from '../data/skills';
import ToolTags from './ToolTags.astro';

interface Props {
  group: SkillGroup;
  locale: Locale;
}

const { group, locale } = Astro.props;
---

<article class="group" data-draw data-reveal-item>
  <h3 class="label">{pick(group.label, locale)}</h3>
  <p>{pick(group.description, locale)}</p>
  <ToolTags tools={group.tools} />
</article>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 18px;
    border-top: var(--hairline) solid var(--rule);
  }

  .label {
    font-size: var(--text-label-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  p {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }
</style>
