---
/**
 * One skill area: label, one line of plain language, and its tool tags.
 */
import type { Locale } from '../i18n/config';
import { pick } from '../i18n/localized';
import type { SkillGroup } from '../data/skills';

interface Props {
  group: SkillGroup;
  locale: Locale;
}

const { group, locale } = Astro.props;
---

<article class="group">
  <h3 class="label">{pick(group.label, locale)}</h3>
  <p>{pick(group.description, locale)}</p>
  <ul class="tools" role="list">
    {group.tools.map((tool) => (
      <li class="tool">{tool}</li>
    ))}
  </ul>
</article>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 18px;
    border-top: var(--hairline) solid var(--rule);
  }

  .label {
    font-size: var(--text-label-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  p {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--ink-2);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2px;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    font-size: var(--text-sm);
    line-height: var(--leading-none);
    box-shadow: inset 0 0 0 var(--hairline) var(--rule);
  }
</style>
