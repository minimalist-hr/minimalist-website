---
import MetaPanel, { type MetaItem } from '../components/MetaPanel.astro';
import CtaBand from '../components/CtaBand.astro';
import CtaLink from '../components/CtaLink.astro';
import AnnotatedImage from '../components/AnnotatedImage.astro';
import Quote from '../components/Quote.astro';
import ResultList from '../components/ResultList.astro';
import ToolTags from '../components/ToolTags.astro';
import type { Locale } from '../i18n/config';
import { localizedPath, useTranslations, type Alternates } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { nextSection } from '../lib/navigation';
import type { WorkEntry } from '../lib/content';
import { breadcrumbSchema } from '../lib/structured-data';
import { siteConfig } from '../site.config';

interface Props {
  entry: WorkEntry;
  locale: Locale;
  alternates: Alternates;
}

const { entry, locale, alternates } = Astro.props;
const t = useTranslations(locale);
const {
  title,
  summary,
  client,
  sector,
  year,
  engagement,
  scope,
  website,
  heroImage,
  heroCaption,
  sections = [],
  stack,
  gallery = [],
  results = [],
  quote,
  ctaTitle,
} = entry.data;

const meta: MetaItem[] = [];
if (client) meta.push({ label: t('case.client'), value: client });
meta.push({ label: t('case.sector'), value: sector });
meta.push({ label: t('case.engagement'), value: engagement ?? String(year) });
if (scope) meta.push({ label: t('case.scope'), value: scope });
if (website) {
  meta.push({
    label: t('case.website'),
    value: new URL(website).hostname.replace(/^www\./, ''),
    href: website,
    newTabHint: t('a11y.newTab'),
  });
}
---

<BaseLayout
  title={`${title} — ${siteConfig.name}`}
  description={summary}
  alternates={alternates}
  structuredData={breadcrumbSchema(locale, 'work', { name: title, path: alternates[locale] })}
>
  <article>
    <header class="container head">
      <CtaLink href={localizedPath('work', locale)} back>
        {t('work.backToWork')}
      </CtaLink>
      <h1>{title}</h1>
      <MetaPanel items={meta} />
    </header>

    {(heroImage || heroCaption) && (
      <div class="container hero-image">
        <AnnotatedImage
          caption={heroCaption ?? ''}
          image={heroImage}
          locale={locale}
          ratio="16/9"
          sizes="100vw"
          priority
        />
      </div>
    )}

    <div class="container body">
      {sections.length > 0 && (
        <div class="sections">
          {sections.map((section) => (
            <section class="block" data-draw>
              <h2>{section.label}</h2>
              {section.paragraphs.map((paragraph) => (
                <p class:list={['text', paragraph.lead && 'text-lead']}>{paragraph.text}</p>
              ))}
            </section>
          ))}
        </div>
      )}

      {gallery.length > 0 && (
        <div class="gallery">
          {/* Screenshots are 4:5; placeholders 4:3. */}
          {gallery.map((item) => (
            <AnnotatedImage
              caption={item.caption}
              image={item.image}
              locale={locale}
              ratio={item.image ? '4/5' : '4/3'}
              sizes="(min-width: 60rem) 50vw, 100vw"
            />
          ))}
        </div>
      )}

      {stack && (
        <section class="block" data-draw>
          <h2>{t('case.stack')}</h2>
          {stack.text && <p class="text text-wide">{stack.text}</p>}
          <ToolTags tools={stack.tools} />
        </section>
      )}

      {results.length > 0 && <ResultList label={t('case.results')} results={results} />}

      {quote && <Quote text={quote.text} name={quote.name} role={quote.role} />}

      {ctaTitle && (
        <div class="closing" data-draw>
          <CtaBand
            title={ctaTitle}
            action={{ href: localizedPath('contact', locale), label: t('cta.startProject') }}
            secondary={nextSection('work', locale)}
          />
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(40px, 6vw, 88px) clamp(16px, 2vw, 28px);
  }

  h1 {
    max-width: 22ch;
    margin-top: clamp(24px, 3vw, 40px);
    font-size: var(--text-6xl);
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
  }

  .hero-image {
    padding-block: clamp(16px, 2vw, 28px) clamp(10px, 1.2vw, 16px);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 56px);
    padding-block: clamp(12px, 1.5vw, 20px) clamp(48px, 7vw, 104px);
  }

  .sections {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 3.5vw, 56px);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: clamp(20px, 2.4vw, 28px);
    border-top: var(--hairline) solid var(--rule);
  }

  .block h2 {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--graphite);
  }

  .text {
    max-width: var(--measure-body);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--ink-2);
  }

  .text-lead {
    color: var(--ink);
  }

  /* The stack block spans the full row, so its paragraph is not held to the
     two-column measure the sections above use. */
  .text-wide {
    max-width: 90ch;
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 28px);
  }

  .closing {
    padding-top: clamp(28px, 3.5vw, 48px);
    border-top: var(--hairline) solid var(--rule);
  }

  @media (min-width: 60rem) {
    .sections {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 44%), 1fr));
    }

    .gallery {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 46%), 1fr));
    }
  }
</style>
