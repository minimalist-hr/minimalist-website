---
/** Croatian insight articles, with translated slugs from the file names. */
import type { GetStaticPaths } from 'astro';

import { getEntryAlternates, getInsights, slugOf } from '../../../lib/content';
import InsightView from '../../../views/InsightView.astro';

export const getStaticPaths = (async () => {
  const entries = await getInsights('hr');
  return Promise.all(
    entries.map(async (entry) => ({
      params: { slug: slugOf(entry) },
      props: { entry, alternates: await getEntryAlternates('insights', entry.data.translationKey) },
    })),
  );
}) satisfies GetStaticPaths;

const { entry, alternates } = Astro.props;
---

<InsightView entry={entry} locale="hr" alternates={alternates} />
