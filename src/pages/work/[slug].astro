---
import type { GetStaticPaths } from 'astro';

import { getEntryAlternates, getPublishedWork, slugOf } from '../../lib/content';
import CaseStudyView from '../../views/CaseStudyView.astro';

export const getStaticPaths = (async () => {
  const entries = await getPublishedWork('en');
  return Promise.all(
    entries.map(async (entry) => ({
      params: { slug: slugOf(entry) },
      props: { entry, alternates: await getEntryAlternates('work', entry.data.translationKey) },
    })),
  );
}) satisfies GetStaticPaths;

const { entry, alternates } = Astro.props;
---

<CaseStudyView entry={entry} locale="en" alternates={alternates} />
